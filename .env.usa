# Configuration pour les États-Unis - Tous les services activés
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=msprdatascience
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/msprdatascience

# APIs externes
COVID_DATA_URL=https://covid.ourworldindata.org/data/owid-covid-data.csv
MPOX_KAGGLE_DATASET=utkarshx27/mpox-monkeypox-data

# Sécurité
SECRET_KEY=super_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PgAdmin (activé pour les USA - ils ont des spécialistes)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=adminTest123
ENABLE_PGADMIN=true

# Configuration pays
COUNTRY=usa
ENV=production

# Services activés pour les USA
ENABLE_TECHNICAL_API=true
ENABLE_DATAVIZ=true
HIGH_VOLUME_PROCESSING=true