# Configuration pour la France - Pas d'API technique, focus RGPD
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=msprdatascience
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/msprdatascience

# APIs externes
COVID_DATA_URL=https://covid.ourworldindata.org/data/owid-covid-data.csv
MPOX_KAGGLE_DATASET=utkarshx27/mpox-monkeypox-data

# Sécurité
SECRET_KEY=super_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PgAdmin (désactivé pour la France - pas de spécialiste)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=adminTest123
ENABLE_PGADMIN=false

# Configuration pays
COUNTRY=france
ENV=production

# Services activés pour la France
ENABLE_TECHNICAL_API=false
ENABLE_DATAVIZ=true
RGPD_COMPLIANCE=true